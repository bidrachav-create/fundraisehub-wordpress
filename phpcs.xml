<?xml version="1.0"?>
<ruleset name="FundRaiseHub WordPress">
	<description>FundRaiseHub WordPress plugins coding standards.</description>

	<!-- Scan these directories. -->
	<file>fundraisehub-core</file>
	<file>fundraisehub-elementor</file>

	<!-- Exclude compiled build artefacts. -->
	<exclude-pattern>fundraisehub-core/assets/*</exclude-pattern>

	<!-- Exclude non-PHP file types. -->
	<exclude-pattern>*.js</exclude-pattern>
	<exclude-pattern>*.json</exclude-pattern>
	<exclude-pattern>*.css</exclude-pattern>

	<!-- Use WordPress Coding Standards. -->
	<rule ref="WordPress" />

	<!-- Allow the class-blockregistry.php filename convention used in this project. -->
	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="strict_class_file_names" value="false" />
		</properties>
	</rule>
</ruleset>
