{
  "name": "fundraisehub/fundraisehub-wordpress",
  "description": "WordPress plugins for embedding FundRaiseHub campaigns",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "*",
    "squizlabs/php_codesniffer": "^3.8"
  },
  "autoload": {
    "psr-4": {
      "FundRaiseHub\\Core\\": "fundraisehub-core/includes/",
      "FundRaiseHub\\Elementor\\": "fundraisehub-elementor/includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FundRaiseHub\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "phpcs": "phpcs --standard=WordPress fundraisehub-core fundraisehub-elementor",
    "phpcbf": "phpcbf --standard=WordPress fundraisehub-core fundraisehub-elementor",
    "test": "phpunit --configuration phpunit.xml"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
